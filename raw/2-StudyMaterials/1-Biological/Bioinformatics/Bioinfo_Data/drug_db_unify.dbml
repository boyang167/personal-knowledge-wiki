// ttd
Table ttd_biomarker_disease{
biomarker_id text
biomarker_name text
disease_entry text
icd_11 text
icd_10 text
icd_9 text
}
Table ttd_drug_crossmatch{
drug_id text [ref:- ttd_drug.drug_id]
drug_name text
drug_formular text
pubchem_cid text
pubchem_sid text
cas_number text
chebi_id text
superdrug_atc text
superdrug_cas text
}
Table ttd_drug_disease{
drug_id text [ref:> ttd_drug.drug_id]
disease_entry text
icd_11 text [ref:<> ttd_biomarker_disease."icd_11"]
clinical_status text
}
Table ttd_drug{
drug_id text 
trade_name text
drug_company text
thera_class text
drug_type text
drug_inchi text
drug_inchikey text
drug_cano_smiles text
clinical_status text
compound_class text
drug_name text
}
Table ttd_drug_synonym{
drug_id text [ref:> ttd_drug.drug_id]
drug_synonyms text
}
Table ttd_drug_target{
target_id text [ref:> ttd_target.target_id]
drug_id text [ref:> ttd_drug.drug_id]
clinical_status text
moa text
}
Table ttd_target_compound_activity{
target_id text [ref:> ttd_target.target_id]
drug_id text
pubchem_cid integer
activity text
}
Table ttd_target_disease{
target_id text [ref:> ttd_target.target_id]
clinical_status text
disease_entry text
icd_11 text [ref:<> ttd_biomarker_disease."icd_11"]
}
Table ttd_target_kegg{
target_id text [ref:> ttd_target.target_id]
kegg_pathway_id text
kegg_pathway_name text
}
Table ttd_target{
target_id text
target_name text
uniprot_id text
gene_name text
target_type text
target_synonyms text
pdb_struc text
bioclass text
ec_number text
function text
aa_seq text
}
Table ttd_target_wiki{
target_id text [ref:> ttd_target.target_id]
wiki_pathway_id text
wiki_pathway_name text
}

// drugs@fda
Table drugsfda_actiontypes_lookup{
actiontypes_lookupid integer
actiontypes_lookupdescription text
supplcategorylevel1code text
supplcategorylevel2code text
}
Table drugsfda_applicationdocs{
applicationdocsid integer
applicationdocstypeid integer
applno integer  [ref: > drugsfda_applications.applno]
submissiontype text
submissionno integer
applicationdocstitle text
applicationdocsurl text
applicationdocsdate date
}
Table drugsfda_applications{
applno integer [ref: < drugsfda_products.applno]
appltype text
applpublicnotes text
sponsorname text
}
Table drugsfda_applicationsdocstype_lookup{
applicationdocstypeid integer [ref: < drugsfda_applicationdocs.applicationdocstypeid]
applicationdocstypedescription text
}
Table drugsfda_marketingstatus_lookup{
marketingstatusid integer [ref: < drugsfda_marketingstatus.marketingstatusid]
marketingstatusdescription text
}
Table drugsfda_marketingstatus{
marketingstatusid integer
applno integer
productno integer [ref: > drugsfda_products.productno]
}
Table drugsfda_products{
applno integer
productno integer
form text
strength text
referencedrug integer
drugname text
activeingredient text
referencestandard integer
}
Table drugsfda_submissionclass_lookup{
submissionclasscodeid integer [ref: < drugsfda_submissions.submissionclasscodeid]
submissionclasscode text
submissionclasscodedescription text
}
Table drugsfda_submissionpropertytype{
applno integer
submissiontype text
submissionno integer  [ref: > drugsfda_submissions.submissionno]
submissionpropertytypecode text
submissionpropertytypeid integer
}
Table drugsfda_submissions{
applno integer  [ref: > drugsfda_applications.applno]
submissionclasscodeid integer
submissiontype text
submissionno integer
submissionstatus text
submissionstatusdate date
submissionspublicnotes text
reviewpriority text
}
Table drugsfda_te{
applno integer
productno integer [ref: > drugsfda_products.productno]
marketingstatusid integer
tecode text
}

// dgidb
Table dgidb_categories{
name text [ref: <> dgidb_genes.name]
category text
source_db_name text
source_db_version text
}
Table dgidb_drugs{
drug_claim_name text
nomenclature text
concept_id text [ref: <> dgidb_interactions.drug_concept_id]
drug_name text
approved boolean
immunotherapy boolean
anti_neoplastic boolean
source_db_name text
source_db_version text
}
Table dgidb_genes{
name text
nomenclature text
concept_id text [ref: <> dgidb_interactions.gene_concept_id]
gene_claim_name text
source_db_name text
source_db_version text
}
Table dgidb_interactions{
gene_claim_name text
gene_concept_id text
gene_name text
interaction_source_db_name text
interaction_source_db_version text
interaction_type text
interaction_score decimal
drug_claim_name text
drug_concept_id text
drug_name text
approved boolean
immunotherapy boolean
anti_neoplastic boolean
}

